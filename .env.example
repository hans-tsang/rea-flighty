# Copy to .env (git-ignored). EXPO_PUBLIC_* values are bundled into the app and
# are visible to anyone who has the app — NEVER put provider API keys here.

# Which flight data source the app uses. Only "mock" is implemented.
EXPO_PUBLIC_FLIGHT_DATA_PROVIDER=mock

# Future: base URL of OUR backend (which holds provider credentials server-side).
# EXPO_PUBLIC_API_BASE_URL=https://api.example.com

# Server-side only (future backend, not read by the app):
# FLIGHT_PROVIDER=aeroapi
# AEROAPI_KEY=<set in your backend's secret store, not here>
